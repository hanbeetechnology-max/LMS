# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings → API page. Both are safe to expose in frontend code — they're the
# public/anon key, not the service role key (never put that in frontend code).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — only needed if backend/ (the FastAPI prototype) isn't running on
# the default http://localhost:8000.
VITE_API_BASE_URL=
