# Public Supabase project settings. The anon key is safe for browser use because
# authorization is enforced by Supabase Auth and row-level security policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: hosted UPI/payment QR shown to solo tournament entrants.
NEXT_PUBLIC_TOURNAMENT_PAYMENT_QR_URL=

# Dev-only: used by fetchFigma.js to pull design reference from Figma.
# Never needed at runtime and never used by the app itself.
FIGMA_TOKEN=
FIGMA_FILE_KEY=
